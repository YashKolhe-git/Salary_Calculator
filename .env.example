# Copy to .env in the repo root for local Vite dev (optional; dev has defaults).

# Backend Django REST Framework base URL
# Development default: http://127.0.0.1:8000
# Production same-origin deploy: leave unset or empty at build time
VITE_API_BASE_URL=http://127.0.0.1:8000
